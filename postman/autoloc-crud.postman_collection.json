{
  "info": {
    "_postman_id": "3dfcb38d-8ebd-4d2a-9a3c-6b9ccf2ac001",
    "name": "AutoLoc API - CRUD",
    "description": "Validation CRUD des agences, clients et véhicules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Agences",
      "item": [
        {
          "name": "GET - Toutes les agences",
          "request": { "method": "GET", "url": "{{baseUrl}}/agence/retrieve-all-agences" }
        },
        {
          "name": "GET - Une agence",
          "request": { "method": "GET", "url": "{{baseUrl}}/agence/retrieve-agence/{{id}}" }
        },
        {
          "name": "POST - Créer une agence",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Agence Centre\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"10 avenue Habib Bourguiba\",\n  \"telephone\": \"71123456\"\n}" },
            "url": "{{baseUrl}}/agence/add-agence"
          }
        },
        {
          "name": "PUT - Modifier une agence",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idAgence\": {{id}},\n  \"nom\": \"Agence Centre Modifiée\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"10 avenue Habib Bourguiba\",\n  \"telephone\": \"71123457\"\n}" },
            "url": "{{baseUrl}}/agence/update-agence"
          }
        },
        {
          "name": "DELETE - Supprimer une agence",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/agence/remove-agence/{{id}}" }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "GET - Tous les clients",
          "request": { "method": "GET", "url": "{{baseUrl}}/client/retrieve-all-clients" }
        },
        {
          "name": "GET - Un client",
          "request": { "method": "GET", "url": "{{baseUrl}}/client/retrieve-client/{{id}}" }
        },
        {
          "name": "POST - Créer un client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Amine\",\n  \"email\": \"amine.benali@example.com\",\n  \"telephone\": \"22112233\",\n  \"numPermis\": \"TN123456\",\n  \"dateInscription\": \"2026-10-19\"\n}" },
            "url": "{{baseUrl}}/client/add-client"
          }
        },
        {
          "name": "PUT - Modifier un client",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idClient\": {{id}},\n  \"nom\": \"Ben Ali\",\n  \"prenom\": \"Amine\",\n  \"email\": \"amine.benali@example.com\",\n  \"telephone\": \"22112234\",\n  \"numPermis\": \"TN123456\",\n  \"dateInscription\": \"2026-10-19\"\n}" },
            "url": "{{baseUrl}}/client/update-client"
          }
        },
        {
          "name": "DELETE - Supprimer un client",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/client/remove-client/{{id}}" }
        }
      ]
    },
    {
      "name": "Véhicules",
      "item": [
        {
          "name": "GET - Tous les véhicules",
          "request": { "method": "GET", "url": "{{baseUrl}}/vehicule/retrieve-all-vehicules" }
        },
        {
          "name": "GET - Un véhicule",
          "request": { "method": "GET", "url": "{{baseUrl}}/vehicule/retrieve-vehicule/{{id}}" }
        },
        {
          "name": "POST - Créer un véhicule",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"immatriculation\": \"123TU4567\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 120.00,\n  \"statut\": \"DISPONIBLE\"\n}" },
            "url": "{{baseUrl}}/vehicule/add-vehicule"
          }
        },
        {
          "name": "PUT - Modifier un véhicule",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idVehicule\": {{id}},\n  \"immatriculation\": \"123TU4567\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 130.00,\n  \"statut\": \"DISPONIBLE\"\n}" },
            "url": "{{baseUrl}}/vehicule/update-vehicule"
          }
        },
        {
          "name": "DELETE - Supprimer un véhicule",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/vehicule/remove-vehicule/{{id}}" }
        }
      ]
    }
  ]
}
